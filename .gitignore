# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# landing media (served by Vercel as static files from public/)
# Git carries only what the six pages show: all of v3, and from the V2 pack its manifest and the
# files listed by `node source-assets/landing-v3/qa/media.mjs` (added with `git add -f`; `npm test`
# MEDIA-6 fails when the two differ). The rest of the V2 pack stays on the machine that made it:
# approved originals of the re-encoded films, and films and stills no page uses. Not deleted, not committed.
/public/assets/landing/v2/*
!/public/assets/landing/v2/manifest.json
